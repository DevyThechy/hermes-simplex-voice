+    async def _call_audio_loop(self, contact_id: str) -> None:
+        """Inbound -> VAD -> STT -> LLM -> TTS -> outbound."""
+        st = {"speaking": False, "epoch": 0, "buf": [], "vad_silence": 0.0}
