+    async def _call_apply_answer(self, resp: dict) -> None:
+        """Apply the caller's WebRTC answer (bot is callee, sent the offer)."""
+        from aiortc import RTCSessionDescription
+        from lzstring import LZString
+
+        if self._call_pc is None:
+            return
+        answer = resp.get("callAnswer") or resp.get("answer") or {}
+        session_b64 = answer.get("rtcSession") or ""
+        if not session_b64:
+            logger.warning("SimpleX call: answer without rtcSession")
+            return
+        try:
+            raw = LZString.decompressFromBase64(session_b64)
+            obj = json.loads(raw)
+            sdp = obj.get("sdp", "")
+            desc = RTCSessionDescription(sdp=sdp, type="answer")
+            await self._call_pc.setRemoteDescription(desc)
+            logger.warning("SimpleX call: answer applied")
+            if self._call_audio_task is None:
+                self._call_audio_task = asyncio.create_task(
+                    self._call_audio_loop(self._call_contact_id)
