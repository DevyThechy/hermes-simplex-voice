+    async def _call_handle_invitation(self, resp: dict) -> None:
+        """Incoming call invitation — the bot is CALLEE = WebRTC OFFERER.
+
+        Sends ``/_call offer`` carrying aiortc's local SDP (vanilla ICE embeds
+        all candidates). The daemon injects the DH pub key from the invite.
+        """
+        from aiortc import RTCPeerConnection
+        from lzstring import LZString
+
+        # The daemon nests the contact inside the invitation payload.
+        inv = resp.get("callInvitation") or resp.get("invitation") or {}
+        contact = inv.get("contact") or {}
+        contact_id = str(
+            contact.get("contactId")
+            or inv.get("contactId")
+            or resp.get("contactId")
+            or resp.get("contact")
+            or ""
+        )
+        logger.warning(
+            "SimpleX call: invitation from %s (event keys=%s)",
+            _redact_id(contact_id),
+            list(resp.keys()),
+        )
+
+        if self._call_pc is not None:
+            logger.warning(
+                "SimpleX call: busy — rejecting invitation from %s",
+                _redact_id(contact_id),
+            )
+            await self._send_fire_and_forget("/_call reject @%s" % contact_id)
+            return
+
+        self._call_contact_id = contact_id
+
+        # E2EE: the daemon already computed the sharedKey (X25519 DH) and injected it.
+        shared_key = inv.get("sharedKey")
+        self._call_shared_key = shared_key
+        logger.warning(
+            "SimpleX call: E2EE %s from %s (sharedKey=%s)",
+            "ENABLED" if shared_key else "disabled",
+            _redact_id(contact_id),
+            "present" if shared_key else "absent",
+        )
+
+        pc = RTCPeerConnection()
+        self._call_pc = pc
+        self._call_send_track = _CallSendTrack()
+        pc.addTrack(self._call_send_track)
+
+        # E2EE: install the key on the transport if the FrameCryptor is ready.
+        e2ee_key = _simplex_decode_shared_key(shared_key) if shared_key else None
+        if e2ee_key is not None and _simplex_e2ee_install():
+            for _sender in pc.getSenders():
+                _sender.transport._simplex_e2ee_key = e2ee_key
+            for _receiver in pc.getReceivers():
+                _receiver.transport._simplex_e2ee_key = e2ee_key
+            logger.warning("SimpleX call: E2EE media key installed on transport")
+        else:
+            e2ee_key = None
+            logger.warning("SimpleX call: E2EE media key NOT installed (unencrypted)")
+
+        @pc.on("connectionstatechange")
+        async def _on_conn_state():
+            logger.warning("SimpleX call: connection state = %s", pc.connectionState)
+
+        try:
+            offer = await pc.createOffer()
+            await pc.setLocalDescription(offer)
+            sdp = pc.localDescription.sdp
+            session = LZString.compressToBase64(
+                json.dumps({"type": "offer", "sdp": sdp})
+            )
+            payload = {
+                # E2EE: advertise True only if the media key was installed on the
+                # transport (FrameCryptor active); otherwise the call is unencrypted.
+                "callType": {"media": "audio", "capabilities": {"encryption": bool(e2ee_key)}},
+                "rtcSession": {
+                    "rtcSession": session,
+                    "rtcIceCandidates": LZString.compressToBase64("[]"),
+                },
+            }
+            cmd = "/_call offer @%s %s" % (contact_id, json.dumps(payload))
+            await self._send_fire_and_forget(cmd)
+            logger.warning(
+                "SimpleX call: sent offer to %s (%d candidates)",
+                _redact_id(contact_id),
+                sdp.count("a=candidate"),
