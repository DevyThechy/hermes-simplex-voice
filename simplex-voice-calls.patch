+            "Content-Type": "application/json",
+            "Authorization": "Bearer %s" % api_key,
+        }
+        payload = {
+            "model": model,
+            "messages": [
+                {"role": "system", "content": system},
+                {"role": "user", "content": text},
+            ],
+            "max_tokens": 256,
+            "temperature": 0.7,
+        }
+        async with httpx.AsyncClient(timeout=30.0) as client:
+            r = await client.post(url, json=payload, headers=headers)
+            r.raise_for_status()
+            js = r.json()
+            return js["choices"][0]["message"]["content"].strip()
+
+    async def _call_tts(self, text: str) -> bytes:
+        import httpx
+
+        async with httpx.AsyncClient(timeout=60.0) as client:
+            r = await client.post(
+                _CALL_TTS_URL,
+                json={"text": text, "language": _CALL_LANGUAGE},
+            )
+            r.raise_for_status()
+            pcm_out = b""
+            for line in r.text.strip().splitlines():
+                line = line.strip()
+                if not line:
+                    continue
+                try:
+                    js = json.loads(line)
+                except Exception:
+                    continue
+                audio_b64 = js.get("audio", "")
+                if not audio_b64:
+                    continue
+                wav_bytes = base64.b64decode(audio_b64)
+                pcm_out += self._wav_to_pcm48(wav_bytes)
+            return self._trim_silence(pcm_out)
+
+    def _trim_silence(
+        self, pcm: bytes, threshold: int = 500, min_gap: float = 0.35,
+        max_gap: float = 0.12,
+    ) -> bytes:
+        """Collapse long inter-word silences so speech sounds natural."""
+        if not pcm:
+            return pcm
+        try:
+            arr = np.frombuffer(pcm, dtype=np.int16)
+            is_sil = np.abs(arr) < threshold
+            sr = _CALL_SEND_RATE
+            out = []
+            n = len(arr)
+            i = 0
+            while i < n:
+                if not is_sil[i]:
+                    j = i
+                    while j < n and not is_sil[j]:
+                        j += 1
+                    out.append(arr[i:j])
+                    i = j
+                else:
+                    j = i
+                    while j < n and is_sil[j]:
+                        j += 1
+                    gap = (j - i) / sr
+                    if gap > min_gap:
+                        keep = int(max_gap * sr)
+                        out.append(arr[i : i + keep])
+                    else:
+                        out.append(arr[i:j])
+                    i = j
+            if not out:
+                return pcm
+            return np.concatenate(out).astype(np.int16).tobytes()
+        except Exception as e:
+            logger.warning("SimpleX call: trim silence failed: %s", e)
+            return pcm
+
+    def _wav_to_pcm48(self, wav_bytes: bytes) -> bytes:
+        try:
+            import av as _av
+
+            inp = _av.open(io.BytesIO(wav_bytes))
+            resampler = _av.AudioResampler(
+                format="s16", layout="mono", rate=_CALL_SEND_RATE
+            )
+            chunks = []
+            for frame in inp.decode(audio=0):
+                for rf in resampler.resample(frame):
+                    chunks.append(rf.to_ndarray().tobytes())
+            return b"".join(chunks)
+        except Exception as e:
+            logger.warning("SimpleX call: wav decode failed: %s", e)
+            return b""
