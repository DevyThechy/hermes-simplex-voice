+        if arr.dtype == np.int16:
+            arr = arr.astype(np.float32) / 32768.0
+        else:
+            arr = arr.astype(np.float32)
+        if arr.ndim == 2:
+            arr = arr.mean(axis=1) if arr.shape[1] > 1 else arr.reshape(-1)
+        else:
+            arr = arr.reshape(-1)
