+# ---------------------------------------------------------------------------
+# SimpleX call E2EE (FrameCryptor) — monkey-patch aiortc
+# ---------------------------------------------------------------------------
+# Encrypts/decrypts the RTP payload with AES-256-GCM, matching the official
+# SimpleX call protocol (sharedKey from the daemon's DH exchange).
+#
+# Encrypted audio payload layout (clear header = 1 byte, the Opus TOC):
+#   [clear TOC (1B)] [ciphertext (N-1B)] [tag (16B)] [iv (12B)]
+#   AES-256-GCM, random 12B IV per frame, 16B tag, empty AAD.
+#
+# The key is injected on the transport as `_simplex_e2ee_key` (32 bytes).
+# Without it the patches act as passthrough (no encryption).
+_E2EE_CLEAR_HEADER = 1
+_E2EE_IV_SIZE = 12
+_E2EE_KEY_ATTR = "_simplex_e2ee_key"
+_SIMPLEX_E2EE_READY = False
+
+
+def _simplex_decode_shared_key(value) -> Optional[bytes]:
+    """Decode the sharedKey (standard or URL-safe base64, with or without padding)."""
+    if not value or not isinstance(value, str):
+        return None
+    padded = value + "=" * (-len(value) % 4)
+    for decoder in (base64.b64decode, base64.urlsafe_b64decode):
+        try:
+            key = decoder(padded)
+            if len(key) == 32:
+                return key
+        except Exception:
+            continue
+    return None
+
+
+def _simplex_rtp_payload_bounds(data: bytes):
+    """Start/end offsets of the RTP payload (honors CSRC/extension/padding)."""
+    b0 = data[0]
+    off = 12 + (b0 & 0x0F) * 4
+    if (b0 >> 4) & 1 and len(data) >= off + 4:
+        off += 4 + int.from_bytes(data[off + 2 : off + 4], "big") * 4
+    end = len(data)
+    if (b0 >> 5) & 1 and end > off:
+        pad = data[-1]
+        if 0 < pad <= end - off:
+            end -= pad
+    return off, end
+
+
+def _simplex_e2ee_install() -> bool:
+    """Monkey-patch aiortc to encrypt/decrypt RTP payloads. Idempotent."""
+    global _SIMPLEX_E2EE_READY
+    if _SIMPLEX_E2EE_READY:
+        return True
+    try:
+        from aiortc.rtcdtlstransport import RTCDtlsTransport
+        from aiortc.rtcrtpreceiver import RTCRtpReceiver
+        from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+
+        def _encrypt(key: bytes, payload: bytes) -> bytes:
+            iv = os.urandom(_E2EE_IV_SIZE)
+            body = payload[_E2EE_CLEAR_HEADER:]
+            return (
+                payload[:_E2EE_CLEAR_HEADER]
+                + AESGCM(key).encrypt(iv, body, None)
+                + iv
+            )
+
+        def _decrypt(key: bytes, payload: bytes) -> bytes:
+            head = payload[:_E2EE_CLEAR_HEADER]
+            rest = payload[_E2EE_CLEAR_HEADER:]
+            body = AESGCM(key).decrypt(rest[-_E2EE_IV_SIZE:], rest[:-_E2EE_IV_SIZE], None)
+            return head + body
+
+        _orig_send_rtp = RTCDtlsTransport._send_rtp
+
+        async def _send_rtp(self, data: bytes) -> None:
+            key = getattr(self, _E2EE_KEY_ATTR, None)
+            if key is not None:
+                try:
+                    off, end = _simplex_rtp_payload_bounds(data)
+                    if end > off:
+                        data = data[:off] + _encrypt(key, data[off:end]) + data[end:]
+                except Exception:
+                    logger.exception(
+                        "SimpleX call: E2EE encrypt failed (frame dropped)"
+                    )
+            await _orig_send_rtp(self, data)
+
+        _orig_handle_rtp = RTCRtpReceiver._handle_rtp_packet
+
+        async def _handle_rtp_packet(self, packet, arrival_time_ms):
+            key = getattr(self.transport, _E2EE_KEY_ATTR, None)
+            if key is not None and packet.payload:
+                try:
+                    packet.payload = _decrypt(key, packet.payload)
+                except Exception:
+                    logger.debug("SimpleX call: E2EE decrypt failed (frame dropped)")
+                    return
+            await _orig_handle_rtp(self, packet, arrival_time_ms=arrival_time_ms)
+
+        RTCDtlsTransport._send_rtp = _send_rtp
+        RTCRtpReceiver._handle_rtp_packet = _handle_rtp_packet
+        _SIMPLEX_E2EE_READY = True
+        logger.warning("SimpleX call: E2EE FrameCryptor installed on aiortc")
+        return True
+    except Exception:
+        logger.exception(
+            "SimpleX call: E2EE monkey-patch failed (unencrypted fallback)"
+        )
+        return False
+
 
