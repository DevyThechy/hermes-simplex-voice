+class _CallSendTrack(MediaStreamTrack):
+    """Outbound audio track serving TTS PCM frames to the aiortc sender."""
+
+    kind = "audio"
+
+    def __init__(self):
+        super().__init__()
+        self._queue = asyncio.Queue()
+        self._stopped = False
+        self._pts = 0
+
+    async def recv(self):
+        if self._stopped:
+            raise MediaStreamError
+        frame = await self._queue.get()
+        if frame is None:
+            raise MediaStreamError
+        return frame
+
+    def push_pcm(self, data: bytes) -> None:
+        # data: s16 mono @ 48kHz bytes
+        step = 960 * 2  # 960 samples * 2 bytes = 20 ms
+        for i in range(0, len(data) - step + 1, step):
+            chunk = data[i : i + step]
+            arr = np.frombuffer(chunk, dtype=np.int16)
+            frame = av.AudioFrame.from_ndarray(
+                arr.reshape(1, -1), format="s16", layout="mono"
+            )
+            frame.sample_rate = _CALL_SEND_RATE
+            frame.pts = self._pts
+            frame.time_base = Fraction(1, _CALL_SEND_RATE)
+            self._pts += 960
+            self._queue.put_nowait(frame)
+
+    def stop(self) -> None:
+        self._stopped = True
+        try:
+            self._queue.put_nowait(None)
+        except Exception:
+            pass
